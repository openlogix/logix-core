// This repo's Open Logix metadata, read by repos-janitor (the website repo's
// CLAUDE.md, Repo types, owns the policy). Change it only by pull request.
{
  "$schema": "https://www.openlogix.org/schemas/logix-repo-metadata-v1.json",
  // Logix Engine downloads its releases as its remote config names them.
  "type": "dependency",
  // This repo takes no issues: its README sends people to openlogix/logix-engine's.
  "issues": "openlogix/logix-engine"
}
